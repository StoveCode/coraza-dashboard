# Coraza Dashboard — Environment Variables
# Copy to .env and adjust values before starting

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=coraza_dashboard
DB_USER=coraza
DB_PASSWORD=changeme

# Backend
SERVER_PORT=8080

# CORS — comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=info

# Postgres internal (used by docker-compose postgres service)
POSTGRES_DB=coraza_dashboard
POSTGRES_USER=coraza
POSTGRES_PASSWORD=changeme
